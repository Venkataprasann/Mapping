# SyncRoute AI Backend Configuration
PORT=5000
NODE_ENV=development

# Supabase (PostgreSQL & Auth)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Maps Platform (Routes API & Places API)
# Server-side key with IP restrictions or Routes API scopes enabled
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-api-key-here

# OpenAI API (for Conversational Voice Assistant)
OPENAI_API_KEY=your-openai-api-key-here

# Web Push Notification VAPID Keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@syncroute.ai

# Security & CORS
ALLOWED_ORIGIN=http://localhost:5173
JWT_SECRET=super-secret-syncroute-dev-jwt-key
